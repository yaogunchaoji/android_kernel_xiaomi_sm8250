# ==========================================
# Hybrid Mount VFS Setup   （在 ENABLE_KSU 分支内，紧跟 setup.sh）
# ==========================================
curl -LSs "https://raw.githubusercontent.com/Hybrid-Mount/meta-hybrid_mount/dev/module/vfs/setup.sh" | bash

echo "[*] Applying Hybrid Mount 4.19 compat patch..."
if grep -q 'KERNEL_VERSION(5, 2, 0)' fs/hybridmount/hybridmount.c; then
    echo "[=] patch already applied, skipping"
elif git apply hybrid-mount.patch; then
    echo "[+] git apply OK"
elif patch -p1 -l --fuzz=3 < hybrid-mount.patch; then
    echo "[+] patch(1) OK"
else
    echo "[!] patch failed, inspect fs/hybridmount/hybridmount.c manually"; exit 1
fi
